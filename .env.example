# Copier en `.env` (jamais versionné). Identifiants des bases locales uniquement.

# Base de référence : données importées et validées, migrée depuis `main` seulement.
ATLAS_REF_USER=atlas
ATLAS_REF_PASSWORD=atlas_ref_local
ATLAS_REF_DB=atlas
ATLAS_REF_PORT=5432

# Base de développement : jetable, recréée par `scripts/db-dev-reset.sh`.
ATLAS_DEV_USER=atlas
ATLAS_DEV_PASSWORD=atlas_dev_local
ATLAS_DEV_DB=atlas_dev
ATLAS_DEV_PORT=5433

# Rôles de connexion d'essai de la base de développement uniquement (docs/schema.md,
# §5.13), créés par `scripts/db-dev-roles.sh` ; ils n'existent jamais sur db-ref.
ATLAS_DEV_AGENT_PASSWORD=atlas_dev_agent_local
ATLAS_DEV_REVIEWER_PASSWORD=atlas_dev_reviewer_local
